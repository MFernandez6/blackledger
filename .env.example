# =============================================================================
# BLACKLEDGER — Financial & payout tracking
# Local: copy to `.env` and `.env.local`
# =============================================================================

# Shared Supabase pooler (same project as BLACKBOX / BLACKMIRROR).
# Transaction pooler (runtime):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (migrations / Prisma directUrl):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# NextAuth — must be a full URL (https://…). Empty string breaks `next build`.
# Local:
NEXTAUTH_URL="http://localhost:3003"
# Vercel: set to the production origin, e.g. https://blackledger-ten.vercel.app
# Also set DATABASE_URL (port 6543, pgbouncer=true) and DIRECT_URL (port 5432).
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Inbound service key (BLACKGATE referral tags, optional machine clients)
BLACKLEDGER_API_KEY="dev-ledger-key"

# BLACKBOX — read-only claim / settlement pull. Never write claim status.
# Same Supabase project as BLACKBOX: snapshots are copied from the Claim table.
# Optional HTTP fallback (BLACKBOX must set BLACKLEDGER_API_KEY to the same value):
BLACKBOX_API_URL="http://localhost:3000"
BLACKBOX_API_KEY="dev-ledger-key"
# Set to 1 only to skip the live pull (empty Files).
BLACKBOX_DRY_RUN=0

# BLACKGATE — partner / referral source pull for split calculations
BLACKGATE_API_URL="http://localhost:3002"
BLACKGATE_API_KEY=

# BLACKLETTER — inbound payout when a settlement / release is executed
# POST /api/payouts/from-settlement (same BLACKLEDGER_API_KEY)

UPLOAD_DIR="public/uploads"

# Seed is destructive — never run against production without this flag
# ALLOW_DESTRUCTIVE_SEED=1
